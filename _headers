# 보안 헤더는 전 경로 공통. Cache-Control은 여기 두지 않는다 —
# /* 에 두면 아래의 구체적 규칙을 덮어버린다(실측 확인).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML은 항상 최신본을 받아야 한다 — 가이드는 자주 고쳐진다
/
  Cache-Control: public, max-age=0, must-revalidate
/climbing/
  Cache-Control: public, max-age=0, must-revalidate
/shoulder/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# .md는 기본값이면 다운로드된다 — 브라우저에서 그대로 읽히게 한다
/*.md
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# 사진은 자체 호스팅한다. 갱신되면 파일이 통째로 갈리므로 길게 잡아도 안전하다
/img/*
  Cache-Control: public, max-age=31536000, immutable

# 생성 삽화는 파일명을 유지한 채 내용만 다시 뽑는다. 길게 캐시하면 옛 그림이 남는다
/genfig/*
  Cache-Control: public, max-age=3600, must-revalidate
